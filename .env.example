# Use the key you have. Gemini is selected when GEMINI_API_KEY is set.
GEMINI_API_KEY=your-gemini-key
# Optional. Defaults to gemini-3.8-flash.
GEMINI_MODEL=gemini-3.8-flash

# OpenAI is used when GEMINI_API_KEY is absent, or when LLM_PROVIDER=openai.
# OPENAI_API_KEY=sk-your-key
# OPENAI_MODEL=gpt-4.1
# LLM_PROVIDER=gemini
